# Raw / processed / cached data -- never commit LendingClub (or any other)
# dataset files. See data/README.md for how to obtain and prepare the
# dataset locally.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# NIZKP circuit toolchain (Phase 3B) -- node_modules/circuit build
# artifacts (r1cs/wasm/zkey/ptau) are large, binary, and fully
# reproducible from src/fairlend/nizkp/circuits/{r_acc.circom,package.json};
# never commit them. See reviewer2_phase3b_nizkp_instantiation_report.md
# for exact tool/library versions and setup reproduction steps.
node_modules/
*.ptau
*.zkey


# Editors / OS
.DS_Store
